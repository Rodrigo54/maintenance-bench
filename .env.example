# Copie este arquivo para .env (nunca commitado) e aponte para a instalação do RimWorld.
# Usado pelo build (Directory.Build.props, referência ao Assembly-CSharp.dll) e por scripts/copy.ps1
# (destino em Mods\). Uma variável de ambiente RIMWORLD_PATH tem prioridade sobre este arquivo.
RIMWORLD_PATH=D:/SteamLibrary/steamapps/common/RimWorld

# Pasta com o 0Harmony.dll do 1.7 (mod Harmony, brrainz.harmony, na Workshop). Usado só pelo build.
HARMONY_PATH=D:/SteamLibrary/steamapps/workshop/content/294100/2009463077/1.7/Assemblies
